<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Expire old requests -->
        <record id="cron_expire_requests" model="ir.cron">
            <field name="name">Document Signer: Expire Overdue Requests</field>
            <field name="model_id" ref="model_sm_document_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_requests()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Send reminders -->
        <record id="cron_send_reminders" model="ir.cron">
            <field name="name">Document Signer: Send Signing Reminders</field>
            <field name="model_id" ref="model_sm_document_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
