<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ========================= -->
        <!-- SIGNER VIEWS (Admin)      -->
        <!-- ========================= -->

        <record id="view_document_signer_list" model="ir.ui.view">
            <field name="name">sm.document.signer.list</field>
            <field name="model">sm.document.signer</field>
            <field name="arch" type="xml">
                <list string="Signers" create="false">
                    <field name="request_id"/>
                    <field name="document_subject"/>
                    <field name="name"/>
                    <field name="email"/>
                    <field name="role"/>
                    <field name="state" widget="badge"
                           decoration-warning="state in ('pending', 'sent')"
                           decoration-info="state == 'viewed'"
                           decoration-success="state == 'signed'"
                           decoration-danger="state in ('declined', 'expired', 'cancelled')"/>
                    <field name="sent_date"/>
                    <field name="viewed_date"/>
                    <field name="signed_date"/>
                    <field name="signed_ip"/>
                    <field name="reminder_count"/>
                </list>
            </field>
        </record>

        <record id="view_document_signer_form" model="ir.ui.view">
            <field name="name">sm.document.signer.form</field>
            <field name="model">sm.document.signer</field>
            <field name="arch" type="xml">
                <form string="Signer Details">
                    <header>
                        <field name="state" widget="statusbar"
                               statusbar_visible="pending,sent,viewed,signed"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Signer Info">
                                <field name="request_id"/>
                                <field name="partner_id"/>
                                <field name="name"/>
                                <field name="email"/>
                                <field name="role"/>
                                <field name="signing_url" widget="url"/>
                            </group>
                            <group string="Signature">
                                <field name="signature" widget="image" readonly="1"/>
                                <field name="signature_type"/>
                                <field name="signed_date"/>
                                <field name="signed_ip"/>
                                <field name="signed_user_agent"/>
                            </group>
                        </group>
                        <group string="Decline Info" invisible="state != 'declined'">
                            <field name="decline_reason"/>
                        </group>
                        <group string="Tracking">
                            <field name="sent_date"/>
                            <field name="viewed_date"/>
                            <field name="reminder_count"/>
                            <field name="access_token" groups="base.group_no_one"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action: All Signers (for admin) -->
        <record id="action_document_signer" model="ir.actions.act_window">
            <field name="name">All Signers</field>
            <field name="res_model">sm.document.signer</field>
            <field name="view_mode">list,form</field>
            <field name="groups_id" eval="[(4, ref('group_signer_manager'))]"/>
        </record>
    </data>
</odoo>
